rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{userId} { allow read, update: if signedIn() && request.auth.uid == userId; allow create: if signedIn(); }
    match /{collection}/{docId} { allow read, write: if signedIn() && collection in ['members','savings','loans','social_fund','meetings']; }
  }
}
